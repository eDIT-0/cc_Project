[resource]
script = ExtResource("1_md")
merchant_id = "wanderer"
title = "Странствующий торговец"
display_name = "Странствующий торговец"
dialogue = ExtResource("3_dlg")
stock_pool = Array[ExtResource("2_item")]([ExtResource("i_homemade_injector"), ExtResource("i_moonshine"), ExtResource("i_knife_homemade"), ExtResource("i_molotov"), ExtResource("i_gunpowder"), ExtResource("i_metal_parts_small"), ExtResource("i_metal_parts_large"), ExtResource("i_ammo_45"), ExtResource("i_ammo_heavy"), ExtResource("i_cloth")])
offers_count = 4
restock_each_run = true
price_multiplier = 1.5
