[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://Scripts/Items/item_data.gd" id="1_item"]
[ext_resource type="Script" path="res://Scripts/Items/log_stub_effect.gd" id="2_stub"]
[ext_resource type="Script" path="res://Scripts/Items/item_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://Scripts/Items/chance_effect.gd" id="4_chance"]

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("2_stub")
message = "восстановление здоровья (заглушка)"

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("2_stub")
message = "наложен дебафф (заглушка — статусов ещё нет)"

[sub_resource type="Resource" id="Resource_e3"]
script = ExtResource("4_chance")
success_chance = 0.6
on_success = Array[ExtResource("3_effect")]([SubResource("Resource_e1")])
on_failure = Array[ExtResource("3_effect")]([SubResource("Resource_e2")])

[resource]
script = ExtResource("1_item")
item_id = "homemade_injector"
display_name = "Самодельный инъектор"
description = "Кустарная смесь в старом шприце. Может помочь. А может и нет."
max_stack = 3
usable_in_field = true
usable_in_combat = true
base_price = 40
effects = Array[ExtResource("3_effect")]([SubResource("Resource_e3")])
