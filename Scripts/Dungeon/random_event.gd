class_name RandomEvent
extends Resource
## Аналог EventEntry из RandomEventListSO.
## (Отдельный RandomEventSO.cs в Unity-версии не использовался нигде в коде —
## это, судя по всему, мёртвый дубликат, поэтому в порт беру только эту версию.)

@export var title: String = "Новый ивент"  ## Внутренний ярлык — в логах/варнингах, игрок его не видит
@export_range(1, 100) var weight: int = 30
## Сколько раз это конкретное событие может сработать за один забег по
## лабиринту. 0 = без ограничения (так вело себя любое событие раньше —
## поведение по умолчанию не меняется). Счётчик держит не сам ресурс
## (он — просто данные, общие для всех копий), а DungeonRun — там он
## привязан к конкретному забегу и сам обнуляется с новой генерацией.
@export var max_occurrences_per_run: int = 0

@export_group("Диалог")
## Каждый ивент — свой отдельный .dialogue-файл (как side_quest_offer.dialogue
## у квестодателей, только не общий на всех, а собственный). Так и должно
## быть по задумке: разные ивенты со временем будут запускать разное
## поведение, а не укладываться в один и тот же шаблон "взять/пройти мимо" —
## общий шаблон был временной заглушкой, пока диалоговой ветки не было вообще.
@export var dialogue: DialogueResource

@export_group("Спец-условия")
## Единственный пока существующий пример — "дыра в стене": этому событию
## нужна подходящая геометрия рядом (стена, а за ней пустой непосещённый
## пол), иначе показывать нечего. Когда флаг включён, DungeonRun
## проверяет условие ДО розыгрыша и, если оно не выполнено, это событие
## просто не участвует в розыгрыше в этот заход — розыгрыш достанется
## другому событию из пула, а не "выпадет и ничего не покажет". Не
## разрастается в общую систему условий специально: пока ровно один такой
## случай, отдельное булево поле дешевле, чем городить общую систему
## условий ради единственного потребителя.
@export var requires_wall_hole_geometry: bool = false

@export_group("Оформление (задел на будущее)")
## Пока нигде не читается — рендер лабиринта временный, см. DebugMazeView.
## Поле уже тут, чтобы не пересобирать ресурсы задним числом, когда
## появится нормальный экран с картинкой вместо консоли.
@export var image: Texture2D
