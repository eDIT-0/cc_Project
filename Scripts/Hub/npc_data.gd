class_name NPCData
extends Resource
## Персонаж, которого можно встретить в хабе. Намеренно НИКАК не связан с
## HubChoice/навигацией — присутствие NPC на локации будет позже управляться
## отдельной логикой (расписание, уход/приход, способ получения квеста №2
## из четырёх обсуждённых), и эта логика не должна лезть в HubChoice ради
## этого. Пока присутствие статично: просто лежит в HubLocation.npcs.

@export var npc_id: String = ""
@export var display_name: String = ""
@export var portrait: Texture2D

@export_group("Диалог")
## Пока единственное, что умеет NPC — предложить сайд-квест. Когда появится
## что-то сложнее одного сценария (несколько реплик, состояния "квест уже
## взят"/"квест сдан", ветвление) — вырастет в отдельный ресурс диалогового
## дерева. Строить его сейчас рано: усложнять интерфейс несуществующих
## сценариев — то же самое, от чего мы уже отказались с HubChoice.
@export var offered_quest: SideQuestEvent
